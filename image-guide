import * as ecs from '@8thwall/ecs'  // This is how you access the ecs library.

ecs.registerComponent({
  name: 'image-guide',
  // schema: {
  // },
  // schemaDefaults: {
  // },
  // data: {
  // },
  add: (world, component) => {
    world.events.addListener(world.events.globalId, 'reality.imagefound', (e) => {
      // Show image guide on image foundß
      ecs.Hidden.remove(world, component.eid)
    })
  },
  // tick: (world, component) => {
  // },
  // remove: (world, component) => {
  // },
  stateMachine: ({world, eid, schemaAttribute}) => {
    ecs.defineState('default')
      .initial()
      .listen(world.events.globalId, 'reality.trackingstatus', (e) => {
        const {scene} = schemaAttribute.get(eid)

        if (e.data.status === 'LIMITED') {
        // Hide image guide
          console.log("hide image guide")
          ecs.Hidden.set(world, eid)
        } else if (e.data.status === 'NORMAL') {
        // Show image guide
          console.log("show image guide")
          ecs.Hidden.remove(world, eid)
        }
      })
  },
})
